[Unit]
Description=RBOLA web app (staging, devnet)
After=network.target

[Service]
User=rbola
WorkingDirectory=/srv/rbola-staging/app/web
EnvironmentFile=/srv/rbola-staging/env
Environment=NODE_ENV=production PORT=3001
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
